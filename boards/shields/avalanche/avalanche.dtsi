#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zephyr,display = &oled;
        zmk,kscan = &kscan0;
        zmk,physical-layout = &avalanche_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
//        | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  |
//        | SW7  | SW8  | SW9  | SW10 | SW11 | SW12 |
// | SW27 | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 |
//        | SW20 | SW21 | SW22 | SW23 | SW24 | SW25 | SW26 | SW19 |
//                             | SW28 | SW29 | SW30 | SW31 | SW32 |
        map = <
          RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                                   RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
          RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                                   RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) 
  RC(4,0) RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                                   RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(4,13)
          RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(2,6)   RC(2,7) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
                                  RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6)   RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };

    /*
     * Physical layout, needed by ZMK Studio. Key order and positions follow
     * default_transform and config/info.json (64 keys), shifted 1 unit right so
     * no x is negative.
     */
    avalanche_layout: avalanche_layout {
        compatible = "zmk,physical-layout";
        display-name = "Avalanche";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys  //                     w   h     x    y rot rx ry
                = <&key_physical_attrs 100 100   100   50 0 0 0>
                , <&key_physical_attrs 100 100   200   50 0 0 0>
                , <&key_physical_attrs 100 100   300   20 0 0 0>
                , <&key_physical_attrs 100 100   400    0 0 0 0>
                , <&key_physical_attrs 100 100   500   25 0 0 0>
                , <&key_physical_attrs 100 100   600   25 0 0 0>
                , <&key_physical_attrs 100 100  1200   25 0 0 0>
                , <&key_physical_attrs 100 100  1300   25 0 0 0>
                , <&key_physical_attrs 100 100  1400    0 0 0 0>
                , <&key_physical_attrs 100 100  1500   20 0 0 0>
                , <&key_physical_attrs 100 100  1600   50 0 0 0>
                , <&key_physical_attrs 100 100  1700   50 0 0 0>
                , <&key_physical_attrs 100 100   100  150 0 0 0>
                , <&key_physical_attrs 100 100   200  150 0 0 0>
                , <&key_physical_attrs 100 100   300  120 0 0 0>
                , <&key_physical_attrs 100 100   400  100 0 0 0>
                , <&key_physical_attrs 100 100   500  125 0 0 0>
                , <&key_physical_attrs 100 100   600  125 0 0 0>
                , <&key_physical_attrs 100 100  1200  125 0 0 0>
                , <&key_physical_attrs 100 100  1300  125 0 0 0>
                , <&key_physical_attrs 100 100  1400  100 0 0 0>
                , <&key_physical_attrs 100 100  1500  120 0 0 0>
                , <&key_physical_attrs 100 100  1600  150 0 0 0>
                , <&key_physical_attrs 100 100  1700  150 0 0 0>
                , <&key_physical_attrs 100 100     0  250 0 0 0>
                , <&key_physical_attrs 100 100   100  250 0 0 0>
                , <&key_physical_attrs 100 100   200  250 0 0 0>
                , <&key_physical_attrs 100 100   300  220 0 0 0>
                , <&key_physical_attrs 100 100   400  200 0 0 0>
                , <&key_physical_attrs 100 100   500  225 0 0 0>
                , <&key_physical_attrs 100 100   600  225 0 0 0>
                , <&key_physical_attrs 100 100  1200  225 0 0 0>
                , <&key_physical_attrs 100 100  1300  225 0 0 0>
                , <&key_physical_attrs 100 100  1400  200 0 0 0>
                , <&key_physical_attrs 100 100  1500  220 0 0 0>
                , <&key_physical_attrs 100 100  1600  250 0 0 0>
                , <&key_physical_attrs 100 100  1700  250 0 0 0>
                , <&key_physical_attrs 100 100  1800  250 0 0 0>
                , <&key_physical_attrs 100 100   100  350 0 0 0>
                , <&key_physical_attrs 100 100   200  350 0 0 0>
                , <&key_physical_attrs 100 100   300  320 0 0 0>
                , <&key_physical_attrs 100 100   400  300 0 0 0>
                , <&key_physical_attrs 100 100   500  325 0 0 0>
                , <&key_physical_attrs 100 100   600  325 0 0 0>
                , <&key_physical_attrs 100 100   700  325 0 0 0>
                , <&key_physical_attrs 100 100   800  325 0 0 0>
                , <&key_physical_attrs 100 100  1000  325 0 0 0>
                , <&key_physical_attrs 100 100  1100  325 0 0 0>
                , <&key_physical_attrs 100 100  1200  325 0 0 0>
                , <&key_physical_attrs 100 100  1300  325 0 0 0>
                , <&key_physical_attrs 100 100  1400  300 0 0 0>
                , <&key_physical_attrs 100 100  1500  320 0 0 0>
                , <&key_physical_attrs 100 100  1600  350 0 0 0>
                , <&key_physical_attrs 100 100  1700  350 0 0 0>
                , <&key_physical_attrs 100 100   400  405 0 0 0>
                , <&key_physical_attrs 100 100   500  425 0 0 0>
                , <&key_physical_attrs 100 100   600  425 0 0 0>
                , <&key_physical_attrs 100 100   700  425 0 0 0>
                , <&key_physical_attrs 100 100   800  425 0 0 0>
                , <&key_physical_attrs 100 100  1000  425 0 0 0>
                , <&key_physical_attrs 100 100  1100  425 0 0 0>
                , <&key_physical_attrs 100 100  1200  425 0 0 0>
                , <&key_physical_attrs 100 100  1300  425 0 0 0>
                , <&key_physical_attrs 100 100  1400  405 0 0 0>
                ;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";

        diode-direction = "col2row";
        // #define MATRIX_ROW_PINS { D4, C6, D7, E6, B4 }
        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        label = "LEFT_ENCODER";
        a-gpios = <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        resolution = <4>;
        status = "disabled";
    };

    right_encoder: encoder_right {
        compatible = "alps,ec11";
        label = "RIGHT_ENCODER";
        a-gpios = <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        resolution = <4>;
        status = "disabled";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
    };
};

&pro_micro_i2c {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        label = "DISPLAY";
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        prechargep = <0x22>;
    };
};
